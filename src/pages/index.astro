---
import Header from '../components/Header.astro';
import "../styles/global.css";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>Bier'SI</title>
    <link rel="icon" type="image/png" href="/images/logoUniquementSansFond.png">
  </head>
  <body class="font-sans text-gray-800 bg-white">
    <Header />

    <!-- HERO SECTION -->
    <section class="pt-32 pb-24 text-center">
      <h1 class="text-5xl font-light leading-tight mb-4">Construisez une présence en ligne élégante</h1>
      <p class="text-lg text-gray-500 max-w-xl mx-auto">Un site clair, rapide, responsive. Sans superflu.</p>
    </section>

    <!-- SERVICES -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-light text-center mb-12">Mes services</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <div class="border border-gray-200 rounded-lg p-6 text-center hover:shadow-sm transition">
            <h3 class="text-xl font-medium mb-2">Site vitrine</h3>
            <p class="text-gray-500">Une page claire pour présenter votre activité.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-6 text-center hover:shadow-sm transition">
            <h3 class="text-xl font-medium mb-2">Design moderne</h3>
            <p class="text-gray-500">Des interfaces épurées et responsives.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-6 text-center hover:shadow-sm transition">
            <h3 class="text-xl font-medium mb-2">Performance</h3>
            <p class="text-gray-500">Un chargement ultra-rapide optimisé SEO.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PortFolio -->
    <section id="portfolio" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center text-biersibleue mb-12">Mes Réalisations</h2>

        <!-- PROJET 1 -->
        <div class="flex flex-col md:flex-row items-center gap-10 mb-16">
          
          <!-- Image + bouton -->
          <div class="w-full md:w-1/2 flex justify-center">
            <div class="w-full max-w-[600px] border rounded-lg overflow-hidden shadow-lg bg-white">
              <div class="aspect-[2/1] w-full">
                <img src="/images/projet/boulangerie.png"
                    alt="Projet Boulangerie"
                    class="w-full h-full object-cover" />
              </div>
              <div class="bg-gray-100 p-5 text-center">
                <a href="https://lien-du-projet.com" target="_blank"
                  class="inline-block px-6 py-3 bg-biersibleue text-white font-semibold rounded hover:bg-biersiorange transition duration-300 shadow">
                  Voir le site
                </a>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="w-full md:w-1/2 text-gray-700">
            <h3 class="text-2xl font-bold text-biersibleue mb-4">Site vitrine pour une boulangerie artisanale locale</h3>
            <p class="mb-4 leading-relaxed">
              Conception d’un site vitrine moderne et responsive pour une boulangerie artisanale de quartier.
              L’objectif : mettre en avant les produits faits maison, les horaires d’ouverture, les actualités du fournil,
              et faciliter le contact client.
            </p>
            <p class="mb-4 leading-relaxed">
              Le site a été développé sur-mesure avec <strong>Astro</strong>, <strong>Tailwind CSS</strong> et <strong>HTML</strong>,
              avec une navigation fluide et un design chaleureux inspiré de l’univers du pain.
            </p>
            <ul class="list-disc pl-5 space-y-2 text-sm text-gray-600">
              <li>📸 Galerie photo des pains, viennoiseries et pâtisseries</li>
              <li>🕒 Mise à jour facile des horaires et jours de fermeture</li>
              <li>📱 Optimisation mobile & référencement local SEO</li>
            </ul>
            <p class="mt-4 text-sm italic text-gray-500">
              Projet livré en 2 semaines avec documentation personnalisée pour une autonomie totale du client.
            </p>
          </div>
        </div>

      </div>
    </section>
    

    <!-- CONTACT -->
    <section id="contact" class="py-20">
      <div class="max-w-lg mx-auto text-center">
        <h2 class="text-2xl font-light mb-6">Contact</h2>
        <form class="space-y-4">
          <input type="text" placeholder="Nom" class="w-full border border-gray-300 p-3 rounded focus:outline-none focus:border-gray-600" />
          <input type="email" placeholder="Email" class="w-full border border-gray-300 p-3 rounded focus:outline-none focus:border-gray-600" />
          <textarea placeholder="Message" class="w-full border border-gray-300 p-3 rounded h-32 focus:outline-none focus:border-gray-600"></textarea>
          <button type="submit" class="w-full bg-gray-800 text-white py-3 rounded hover:bg-gray-700 transition">
            Envoyer
          </button>
        </form>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="text-center py-8 text-sm text-gray-400">
      &copy; 2025 MonSite. Design épuré. Tous droits réservés.
    </footer>
  </body>
</html>
